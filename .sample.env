BOT_TOKEN=
MONGO_SRV=
# Numeric Telegram account/user ID of the only owner allowed to /login and manage settings
OWNER=

# Optional: defaults are retained in functions/config.py; use your own Telegram API app values if available.
API_ID=
API_HASH=

# Optional runtime settings
SEND_SCHEDULE=False
THUMBNAIL=https://graph.org/file/ad1b25807b81cdf1dff65.jpg
CRF=27
FFMPEG=ffmpeg
RESTART_EVERDAY=False
LOG_ON_MAIN=False

